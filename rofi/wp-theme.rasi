configuration {
    show-icons: false;
}

* {
    bg:       #18181b;
    bg-alt:   #27272a;
    fg:       #a78bfa;
    fg-dim:   #7c5cbf;
    accent:   #a78bfa;
    font:     "JetBrainsMono Nerd Font 12";
}

window {
    width:            420px;
    background-color: #18181b;
    border:           2px;
    border-color:     #a78bfa;
    border-radius:    14px;
    padding:          14px;
}

mainbox {
    background-color: transparent;
    spacing:          8px;
}

inputbar {
    background-color: #27272a;
    border-radius:    10px;
    padding:          10px 14px;
    spacing:          8px;
    children:         [prompt, entry];
}

prompt {
    background-color: transparent;
    text-color:       #a78bfa;
}

entry {
    background-color: transparent;
    text-color:       #a78bfa;
    placeholder:      "type to filter...";
    placeholder-color: #7c5cbf;
}

listview {
    background-color: transparent;
    lines:            6;
    spacing:          4px;
    scrollbar:        false;
}

element {
    background-color: transparent;
    border-radius:    8px;
    padding:          10px 14px;
}

element normal.normal {
    background-color: transparent;
    text-color:       #a78bfa;
}

element selected.normal {
    background-color: #27272a;
    text-color:       #ffffff;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

element alternate.normal {
    background-color: transparent;
    text-color:       #a78bfa;
}

element alternate.selected {
    background-color: #27272a;
    text-color:       #ffffff;
}
